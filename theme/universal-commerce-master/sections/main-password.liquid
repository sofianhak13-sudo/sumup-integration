<h1>{{ shop.name }}</h1>
<p>{{ 'general.password_page_text' | t }}</p>

{%- form 'storefront_password' -%}
  {%- if form.errors -%}
    <p style="color: rgb(var(--color-error));">{{ 'general.password_page_error' | t }}</p>
  {%- endif -%}
  <input type="password" name="password" class="field" placeholder="{{ 'general.password' | t }}" required>
  <button type="submit" class="btn btn--full" style="margin-top: var(--space-sm);">{{ 'general.enter' | t }}</button>
{%- endform -%}

{% schema %}
{ "name": "t:names.password_page" }
{% endschema %}
