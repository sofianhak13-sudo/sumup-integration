<section class="section">
  <div class="container">
    <h1>{{ blog.title }}</h1>
    {%- paginate blog.articles by 12 -%}
      <div class="grid" style="--grid-cols-mobile: 1; --grid-cols-desktop: 3;">
        {%- for article in blog.articles -%}
          <a href="{{ article.url }}" class="card card--hover-{{ settings.card_hover }}">
            <div class="card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}
              {%- else -%}
                {{ 'lifestyle-1' | placeholder_svg_tag }}
              {%- endif -%}
            </div>
            <div class="card__body">
              <p class="product-card__title">{{ article.title }}</p>
              <p class="product-card__vendor">{{ article.published_at | date: '%B %d, %Y' }}</p>
            </div>
          </a>
        {%- endfor -%}
      </div>
      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="{{ 'collection.pagination' | t }}">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">&larr;</a>{%- endif -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">&rarr;</a>{%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{ "name": "t:names.blog_page" }
{% endschema %}
