<div class="section featured-collection">
  <div class="container">
    <div class="featured-collection__header">
      {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
      {%- if section.settings.collection -%}
        <a href="{{ section.settings.collection.url }}" class="btn btn--tertiary">{{ 'general.view_all' | t }}</a>
      {%- endif -%}
    </div>

    {%- if section.settings.collection -%}
      <div class="grid" style="--grid-cols-mobile: 2; --grid-cols-desktop: {{ section.settings.columns_desktop }};">
        {%- for product in section.settings.collection.products limit: section.settings.products_count -%}
          {%- render 'product-card', product: product -%}
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</div>

{% style %}
  .featured-collection__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-md); }
{% endstyle %}

{% schema %}
{
  "name": "t:names.featured_collection",
  "class": "section-featured-collection",
  "settings": [
    { "type": "text", "id": "heading", "label": "t:content.heading", "default": "Featured products" },
    { "type": "collection", "id": "collection", "label": "t:content.collection" },
    { "type": "range", "id": "products_count", "label": "t:content.count", "min": 2, "max": 12, "step": 1, "default": 8 },
    { "type": "range", "id": "columns_desktop", "label": "t:content.columns_desktop", "min": 2, "max": 5, "step": 1, "default": 4 }
  ],
  "presets": [{ "name": "t:names.featured_collection" }]
}
{% endschema %}
