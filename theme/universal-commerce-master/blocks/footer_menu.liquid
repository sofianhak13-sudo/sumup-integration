{%- assign menu = block.settings.menu -%}
<div class="footer-menu" {{ block.shopify_attributes }}>
  {%- if block.settings.heading != blank -%}
    <h3 class="footer-menu__heading">{{ block.settings.heading }}</h3>
  {%- endif -%}
  {%- if menu -%}
    <ul class="footer-menu__list">
      {%- for link in menu.links -%}
        <li><a href="{{ link.url }}">{{ link.title }}</a></li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</div>

{% style %}
  .footer-menu__heading { font-size: 0.9rem; margin-bottom: var(--space-sm); }
  .footer-menu__list li { margin-bottom: var(--space-2xs); }
  .footer-menu__list a { text-decoration: none; color: rgb(var(--color-text-muted)); }
  .footer-menu__list a:hover { color: rgb(var(--color-text)); }
{% endstyle %}

{% schema %}
{
  "name": "t:names.footer",
  "tag": null,
  "settings": [
    { "type": "text", "id": "heading", "label": "t:content.label", "default": "Shop" },
    { "type": "link_list", "id": "menu", "label": "t:content.menu", "default": "footer" }
  ]
}
{% endschema %}
