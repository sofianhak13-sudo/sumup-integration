<div class="trust-item" {{ block.shopify_attributes }}>
  {%- case block.settings.icon -%}
    {%- when 'shield' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2 4 5v6c0 5 3.4 8.7 8 9 4.6-.3 8-4 8-9V5l-8-3Z"/></svg>
    {%- when 'truck' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 7h11v9H3zM14 11h4l3 3v2h-7z"/><circle cx="7" cy="18" r="1.5"/><circle cx="17" cy="18" r="1.5"/></svg>
    {%- when 'refresh' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M3 12a9 9 0 0 1 15-6.7L21 8M21 3v5h-5M21 12a9 9 0 0 1-15 6.7L3 16m0 5v-5h5"/></svg>
    {%- when 'headset' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 13v-1a8 8 0 0 1 16 0v1"/><rect x="3" y="13" width="4" height="6" rx="1"/><rect x="17" y="13" width="4" height="6" rx="1"/></svg>
    {%- when 'lock' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="4" y="10" width="16" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>
    {%- when 'star' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 2l2.9 6.6 7.1.7-5.4 4.7 1.6 7-6.2-3.7L5.8 21l1.6-7-5.4-4.7 7.1-.7L12 2z"/></svg>
    {%- when 'gift' -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="8" width="18" height="13" rx="1"/><path d="M12 8v13M3 12h18M12 8c-2 0-3-1.5-3-3s1-3 3-3 3 3 0 6zM12 8c2 0 3-1.5 3-3s-1-3-3-3-3 3 0 6z"/></svg>
    {%- else -%}<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12l5 5L20 6"/></svg>
  {%- endcase -%}
  <span>{{ block.settings.label }}</span>
</div>

{% style %}
  .trust-item { display: flex; align-items: center; gap: var(--space-2xs); font-size: 0.875rem; font-weight: 500; white-space: nowrap; }
{% endstyle %}

{% schema %}
{
  "name": "t:names.trust_items",
  "tag": null,
  "settings": [
    { "type": "select", "id": "icon", "label": "t:content.icon", "options": [
      { "value": "shield", "label": "Shield" },
      { "value": "truck", "label": "Truck" },
      { "value": "refresh", "label": "Refresh" },
      { "value": "headset", "label": "Headset" },
      { "value": "lock", "label": "Lock" },
      { "value": "star", "label": "Star" },
      { "value": "gift", "label": "Gift" },
      { "value": "check", "label": "Check" }
    ], "default": "shield" },
    { "type": "text", "id": "label", "label": "t:content.label", "default": "Secure checkout" }
  ]
}
{% endschema %}
