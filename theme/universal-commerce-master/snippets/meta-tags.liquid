{%- comment -%}
  SEO — Technical Lead layer. Centralizes title/meta/canonical/OG/social +
  JSON-LD structured data so no section ever needs to think about SEO.
  Uses Shopify's own page_title/page_description/canonical_url objects —
  never invents data that doesn't exist.
{%- endcomment -%}

<title>{{ page_title }}{% unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless %}</title>

{%- if page_description -%}
  <meta name="description" content="{{ page_description | escape }}">
{%- endif -%}

<link rel="canonical" href="{{ canonical_url }}">

<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title | escape }}">
{%- if page_description -%}
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif -%}
<meta property="og:type" content="{% if template.name == 'product' %}product{% else %}website{% endif %}">
{%- if template.name == 'product' and product.featured_image -%}
  <meta property="og:image" content="https:{{ product.featured_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- elsif settings.share_image -%}
  <meta property="og:image" content="https:{{ settings.share_image | image_url: width: 1200 }}">
{%- endif -%}

<meta name="twitter:card" content="summary_large_image">

{%- comment -%} Structured data — one type per page, never duplicated. {%- endcomment -%}
{%- if template.name == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | json }},
      "sku": {{ product.selected_or_first_available_variant.sku | json }},
      {%- if product.featured_image -%}
      "image": [{{ product.featured_image | image_url: width: 1200 | prepend: "https:" | json }}],
      {%- endif -%}
      "brand": { "@type": "Brand", "name": {{ product.vendor | json }} },
      "offers": {
        "@type": "Offer",
        "url": {{ canonical_url | json }},
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.selected_or_first_available_variant.price | money_without_currency | strip_html | json }},
        "availability": "https://schema.org/{% if product.selected_or_first_available_variant.available %}InStock{% else %}OutOfStock{% endif %}"
      }
    }
  </script>
{%- elsif template.name == 'article' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Article",
      "headline": {{ article.title | json }},
      "datePublished": {{ article.published_at | date: '%Y-%m-%d' | json }},
      "author": { "@type": "Person", "name": {{ article.author | json }} }
      {%- if article.image -%}
      ,"image": [{{ article.image | image_url: width: 1200 | prepend: "https:" | json }}]
      {%- endif -%}
    }
  </script>
{%- endif -%}

{%- if request.page_type == 'index' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ shop.name | json }},
      "url": {{ shop.url | json }}
    }
  </script>
{%- endif -%}
