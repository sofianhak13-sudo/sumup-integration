{%- comment -%}
  Optional payment adapter — SumUp, cart checkout.

  Isolated by design: only rendered when settings.enable_sumup is on.
  Talks exclusively to the existing SumUp backend through its App Proxy
  (settings.sumup_proxy_path + "/cart"); this theme creates no backend,
  stores no secret, and never computes a price — the backend re-verifies
  every line item's price server-side before creating a checkout.
  Contract (email + cart JSON) matches the deployed sumup-integration app;
  do not change the field names here without also updating that backend.
{%- endcomment -%}

<div class="sumup-cart-adapter" data-sumup-cart-adapter data-endpoint="{{ settings.sumup_proxy_path }}/cart">
  <label class="visually-hidden" for="SumUpCartEmail">{{ 'integrations.sumup.email_placeholder' | t }}</label>
  <input
    type="email"
    id="SumUpCartEmail"
    class="field sumup-cart-adapter__email"
    placeholder="{{ 'integrations.sumup.email_placeholder' | t }}"
    autocomplete="email"
    value="{{ customer.email | escape }}"
    data-sumup-email
  >
  <button type="button" class="btn btn--full btn--secondary" data-sumup-pay-button>
    {{ 'integrations.sumup.pay_button' | t }}
  </button>
  <p class="sumup-cart-adapter__error" role="alert" data-sumup-error hidden></p>
</div>

{% style %}
  .sumup-cart-adapter { margin-top: var(--space-sm); }
  .sumup-cart-adapter__email { margin-bottom: var(--space-2xs); }
  .sumup-cart-adapter__error { color: rgb(var(--color-error)); font-size: 0.8125rem; margin-top: var(--space-2xs); }
{% endstyle %}
