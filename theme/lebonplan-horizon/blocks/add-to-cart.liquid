

{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  assign scoped_class = block.settings.style_class | append: '--' | append: block.id
  assign class = 'add-to-cart-button ' | append: block.settings.style_class | append: ' ' | append: scoped_class
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id
%}
{% render 'button-custom-styles', block_settings: block.settings, block_id: block.id %}
{% render 'premium-button-styles', block_settings: block.settings, block_id: block.id %}
{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}

<span
  {{ block.shopify_attributes }}
  style="--add-to-cart-font-case: {{ settings.button_text_case }};"
>
  {% render 'add-to-cart-button',
    id: id,
    class: class,
    can_add_to_cart: can_add_to_cart,
    show_icon: can_add_to_cart,
    product: closest.product,
    add_to_cart_text: add_to_cart_text,
    data_testid: 'standalone-add-to-cart'
  %}
</span>

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-custom",
          "label": "t:options.custom"
        },
        {
          "value": "button-premium",
          "label": "Premium Glow"
        }
      ],
      "default": "button-secondary",
      "info": "t:info.edit_button_style_in_theme_settings"
    },
    {
      "type": "header",
      "content": "Style Premium Glow",
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "color",
      "id": "premium_bg_color",
      "label": "Fond (début du dégradé)",
      "default": "#07090d",
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "color",
      "id": "premium_bg_gradient_color",
      "label": "Fond (fin du dégradé)",
      "default": "#11151c",
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "color",
      "id": "premium_text_color",
      "label": "Texte",
      "default": "#ffffff",
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "color",
      "id": "premium_border_color",
      "label": "Bordure",
      "default": "#00a8ff",
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "color",
      "id": "premium_glow_color",
      "label": "Couleur du glow",
      "default": "#008cff",
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "range",
      "id": "premium_glow_intensity",
      "label": "Intensité du glow",
      "min": 0,
      "max": 60,
      "step": 2,
      "default": 26,
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "range",
      "id": "premium_border_width",
      "label": "Épaisseur de bordure",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "px",
      "default": 2,
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "range",
      "id": "premium_border_radius",
      "label": "Arrondi",
      "min": 0,
      "max": 50,
      "step": 1,
      "unit": "px",
      "default": 30,
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "checkbox",
      "id": "premium_enable_shine",
      "label": "Activer l'animation \"shine\"",
      "default": true,
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "checkbox",
      "id": "premium_enable_pulse",
      "label": "Activer l'animation \"pulse\"",
      "default": false,
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "range",
      "id": "premium_pulse_duration",
      "label": "Durée de l'animation (s)",
      "min": 2,
      "max": 10,
      "step": 1,
      "default": 5,
      "visible_if": "{{ block.settings.style_class == 'button-premium' }}"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    }
  ]
}
{% endschema %}
