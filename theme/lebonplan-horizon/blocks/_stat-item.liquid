{%- doc -%}
  Un chiffre clé du composant Stats/Counters.
{%- enddoc -%}

<div class="stat-item" {{ block.shopify_attributes }}>
  <span class="stat-item__value">
    {%- if block.settings.prefix != blank -%}<span class="stat-item__affix">{{ block.settings.prefix }}</span>{%- endif -%}
    <span data-count-to="{{ block.settings.value }}">0</span>
    {%- if block.settings.suffix != blank -%}<span class="stat-item__affix">{{ block.settings.suffix }}</span>{%- endif -%}
  </span>
  <span class="stat-item__label">{{ block.settings.label }}</span>
</div>

{% style %}
  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 4px;
  }

  .stat-item__value {
    font-size: 2.25rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }

  .stat-item__label {
    opacity: 0.7;
    font-size: var(--font-size--sm, 0.875rem);
  }
{% endstyle %}

{% schema %}
{
  "name": "Chiffre clé",
  "tag": null,
  "settings": [
    { "type": "text", "id": "value", "label": "Valeur (nombre)", "default": "100" },
    { "type": "text", "id": "prefix", "label": "Préfixe (ex. \"+\")" },
    { "type": "text", "id": "suffix", "label": "Suffixe (ex. \"%\")" },
    { "type": "text", "id": "label", "label": "Libellé", "default": "Libellé" }
  ]
}
{% endschema %}
