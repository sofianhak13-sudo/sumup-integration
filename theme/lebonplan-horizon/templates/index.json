{
  "sections": {
    "hero_main": {
      "type": "hero",
      "blocks": {
        "text_heading": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<p>Welcome to your new store</p>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "text_color": "{{ settings.color_palette.background }}",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          }
        },
        "button_shop": {
          "type": "button",
          "name": "t:names.button",
          "settings": {
            "label": "Shop now",
            "link": "shopify://collections/all",
            "open_in_new_tab": false,
            "style_class": "button",
            "width": "fit-content",
            "custom_width": 100,
            "width_mobile": "fit-content",
            "custom_width_mobile": 100
          }
        }
      },
      "block_order": [
        "text_heading",
        "button_shop"
      ],
      "name": "t:names.hero",
      "settings": {
        "media_type_1": "image",
        "media_type_2": "image",
        "stack_media_on_mobile": false,
        "custom_mobile_media": false,
        "media_type_1_mobile": "image",
        "media_type_2_mobile": "image",
        "open_in_new_tab": false,
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "space-between",
        "vertical_alignment": "flex-end",
        "align_baseline": true,
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "flex-end",
        "gap": 24,
        "section_width": "page-width",
        "section_height": "medium",
        "section_height_custom": 50,
        "background_color": "{{ settings.color_palette.background }}",
        "toggle_overlay": true,
        "overlay_color": "#050505b3",
        "overlay_style": "solid",
        "gradient_direction": "to bottom",
        "blurred_reflection": false,
        "reflection_opacity": 75,
        "padding-block-start": 100,
        "padding-block-end": 72
      }
    },
    "trust_bar_main": {
      "type": "trust-bar",
      "blocks": {
        "trust_1": {
          "type": "_trust-item",
          "settings": {
            "icon": "shield",
            "title": "Secure checkout"
          }
        },
        "trust_2": {
          "type": "_trust-item",
          "settings": {
            "icon": "headset",
            "title": "Customer support"
          }
        },
        "trust_3": {
          "type": "_trust-item",
          "settings": {
            "icon": "refresh",
            "title": "Easy returns"
          }
        }
      },
      "block_order": [
        "trust_1",
        "trust_2",
        "trust_3"
      ],
      "name": "Trust Bar",
      "settings": {
        "layout": "row",
        "section_width": "page-width",
        "padding-block-start": 24,
        "padding-block-end": 24
      }
    },
    "product_list_main": {
      "type": "product-list",
      "blocks": {
        "static-header": {
          "type": "_product-list-content",
          "name": "t:names.header",
          "static": true,
          "settings": {
            "content_direction": "row",
            "vertical_on_mobile": false,
            "horizontal_alignment": "space-between",
            "vertical_alignment": "flex-end",
            "align_baseline": true,
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 12,
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "custom_height": 100,
            "background_media": "none",
            "video_position": "cover",
            "background_image_position": "cover",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_list_text": {
              "type": "_product-list-text",
              "name": "t:names.collection_title",
              "settings": {
                "text": "<h3>Featured products</h3>",
                "width": "fit-content",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h4",
                "font": "var(--font-body--family)",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_list_button": {
              "type": "_product-list-button",
              "name": "t:names.product_list_button",
              "settings": {
                "label": "View all",
                "open_in_new_tab": false,
                "style_class": "link",
                "width": "fit-content",
                "custom_width": 100,
                "width_mobile": "fit-content",
                "custom_width_mobile": 100
              }
            }
          },
          "block_order": [
            "product_list_text",
            "product_list_button"
          ]
        },
        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 4,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {
            "product_card_gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "adapt",
                "border": "none",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 0,
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "product_title": {
              "type": "product-title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "rte",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "background": false,
                "background_color": "#00000026",
                "corner_radius": 0,
                "padding-block-start": 4,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            },
            "price": {
              "type": "price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "h6",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-body--family)",
                "font_size": "1rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "padding-block-start": 0,
                "padding-block-end": 0,
                "padding-inline-start": 0,
                "padding-inline-end": 0
              }
            }
          },
          "block_order": [
            "product_card_gallery",
            "product_title",
            "price"
          ]
        }
      },
      "block_order": [],
      "name": "Featured collection",
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 8,
        "columns": 4,
        "mobile_columns": "2",
        "mobile_card_size": "60cqw",
        "columns_gap": 8,
        "rows_gap": 24,
        "icons_style": "arrow",
        "icons_shape": "none",
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 28,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    },
    "steps_main": {
      "type": "steps",
      "blocks": {
        "step_1": {
          "type": "_step",
          "settings": {
            "number": "1",
            "title": "Browse",
            "text": "Discover products picked for you."
          }
        },
        "step_2": {
          "type": "_step",
          "settings": {
            "number": "2",
            "title": "Order",
            "text": "Checkout securely in a few clicks."
          }
        },
        "step_3": {
          "type": "_step",
          "settings": {
            "number": "3",
            "title": "Enjoy",
            "text": "Your order is on its way."
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ],
      "name": "How it works",
      "settings": {
        "heading": "How it works",
        "layout": "horizontal",
        "show_progress_line": true,
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    },
    "testimonials_main": {
      "type": "testimonials",
      "blocks": {
        "testimonial_1": {
          "type": "_testimonial-card",
          "settings": {}
        },
        "testimonial_2": {
          "type": "_testimonial-card",
          "settings": {}
        },
        "testimonial_3": {
          "type": "_testimonial-card",
          "settings": {}
        }
      },
      "block_order": [
        "testimonial_1",
        "testimonial_2",
        "testimonial_3"
      ],
      "name": "Testimonials / Avis / UGC",
      "settings": {
        "heading": "What customers say",
        "layout": "grid",
        "columns_desktop": 3,
        "columns_mobile": 1,
        "section_width": "page-width",
        "padding-block-start": 64,
        "padding-block-end": 64
      }
    },
    "faq_main": {
      "type": "_blocks",
      "blocks": {
        "accordion_faq": {
          "type": "accordion",
          "name": "FAQ",
          "blocks": {
            "row_1": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What is your shipping policy?"
              },
              "blocks": {
                "text_1": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Replace this with your store's real shipping information.</p>"
                  }
                }
              },
              "block_order": [
                "text_1"
              ]
            },
            "row_2": {
              "type": "_accordion-row",
              "settings": {
                "heading": "What is your return policy?"
              },
              "blocks": {
                "text_2": {
                  "type": "text",
                  "settings": {
                    "text": "<p>Replace this with your store's real return policy.</p>"
                  }
                }
              },
              "block_order": [
                "text_2"
              ]
            }
          },
          "block_order": [
            "row_1",
            "row_2"
          ],
          "settings": {
            "icon": "plus",
            "dividers": true
          }
        }
      },
      "block_order": [
        "accordion_faq"
      ],
      "name": "FAQ",
      "settings": {
        "content_direction": "column"
      }
    }
  },
  "order": [
    "hero_main",
    "trust_bar_main",
    "product_list_main",
    "steps_main",
    "testimonials_main",
    "faq_main"
  ]
}
