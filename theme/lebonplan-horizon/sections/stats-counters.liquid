{% comment %}
  Stats / Counters — chiffres clés avec animation de comptage.
  Nouveau composant Horizon Premium Multistore v1.1.
{% endcomment %}

<div class="section section--{{ section.settings.section_width }}">
  <div class="stats-section spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="stats-section__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="stats-section__grid">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

<script>
  (function () {
    function animateCount(el) {
      var target = parseFloat(el.getAttribute('data-count-to').replace(',', '.'));
      if (isNaN(target)) return;
      var prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReduced) {
        el.textContent = el.getAttribute('data-count-to');
        return;
      }
      var duration = 1400;
      var start = performance.now();
      var decimals = (el.getAttribute('data-count-to').split('.')[1] || '').length;

      function step(now) {
        var progress = Math.min((now - start) / duration, 1);
        var eased = 1 - Math.pow(1 - progress, 3);
        el.textContent = (target * eased).toFixed(decimals);
        if (progress < 1) requestAnimationFrame(step);
      }
      requestAnimationFrame(step);
    }

    var items = document.querySelectorAll('[data-count-to]');
    if (!items.length) return;

    if ('IntersectionObserver' in window) {
      var observer = new IntersectionObserver(function (entries) {
        entries.forEach(function (entry) {
          if (entry.isIntersecting) {
            animateCount(entry.target);
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.5 });
      items.forEach(function (el) { observer.observe(el); });
    } else {
      items.forEach(animateCount);
    }
  })();
</script>

{% style %}
  .stats-section__heading {
    text-align: center;
    margin-block-end: var(--margin-xl, 32px);
  }

  .stats-section__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-lg, 24px);
  }

  @media screen and (min-width: 750px) {
    .stats-section__grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Stats / Compteurs",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_stat-item" }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre (optionnel)" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Largeur",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Pleine largeur" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Espacement" },
    { "type": "range", "id": "padding-block-start", "label": "Haut", "min": 0, "max": 150, "step": 1, "unit": "px", "default": 56 },
    { "type": "range", "id": "padding-block-end", "label": "Bas", "min": 0, "max": 150, "step": 1, "unit": "px", "default": 56 }
  ],
  "presets": [
    {
      "name": "Stats / Compteurs",
      "category": "t:categories.basic",
      "blocks": [
        { "type": "_stat-item", "settings": { "value": "12000", "label": "Clients satisfaits" } },
        { "type": "_stat-item", "settings": { "value": "80", "suffix": "%", "label": "D'économies" } },
        { "type": "_stat-item", "settings": { "value": "4.9", "suffix": "/5", "label": "Note moyenne" } }
      ]
    }
  ]
}
{% endschema %}
