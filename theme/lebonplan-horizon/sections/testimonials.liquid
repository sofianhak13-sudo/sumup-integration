{%- doc -%}
  Testimonials / Reviews / UGC — section sociale premium.
  Nouveau composant Horizon Premium Multistore v1.1.
{%- enddoc -%}

{% liquid
  assign custom_color = false
  if section.settings.background_color != blank or section.settings.text_color != blank
    assign custom_color = true
    render 'contrast-override', background_color: section.settings.background_color, text_color: section.settings.text_color, section_id: section.id
  endif
%}

<div class="section-background{% if custom_color %} color-custom-{{ section.id }}{% endif %}"></div>
<div class="section{% if custom_color %} color-custom-{{ section.id }}{% endif %} section--{{ section.settings.section_width }}">
  <div class="testimonials spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
    {%- if section.settings.heading != blank -%}
      <h2 class="testimonials__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div
      class="testimonials__track testimonials__track--{{ section.settings.layout }}"
      style="--testimonials-columns-desktop: {{ section.settings.columns_desktop }}; --testimonials-columns-mobile: {{ section.settings.columns_mobile }};"
    >
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% style %}
  .testimonials__heading {
    text-align: center;
    margin-block-end: var(--margin-xl, 32px);
  }

  .testimonials__track--grid {
    display: grid;
    grid-template-columns: repeat(var(--testimonials-columns-mobile, 1), 1fr);
    gap: var(--gap-lg, 24px);
  }

  @media screen and (min-width: 750px) {
    .testimonials__track--grid {
      grid-template-columns: repeat(var(--testimonials-columns-desktop, 3), 1fr);
    }
  }

  .testimonials__track--carousel {
    display: flex;
    gap: var(--gap-lg, 24px);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: 4px;
  }

  .testimonials__track--carousel > * {
    scroll-snap-align: start;
    flex: 0 0 min(85%, 340px);
  }

  @media (prefers-reduced-motion: reduce) {
    .testimonials__track--carousel {
      scroll-behavior: auto;
    }
  }
{% endstyle %}

{% schema %}
{
  "name": "Testimonials / Avis / UGC",
  "class": "section-wrapper",
  "blocks": [
    { "type": "_testimonial-card" }
  ],
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Ce qu'ils en disent" },
    {
      "type": "select",
      "id": "layout",
      "label": "Disposition",
      "options": [
        { "value": "grid", "label": "Grille" },
        { "value": "carousel", "label": "Carrousel" }
      ],
      "default": "grid"
    },
    { "type": "range", "id": "columns_desktop", "label": "Colonnes (desktop)", "min": 1, "max": 4, "step": 1, "default": 3, "visible_if": "{{ section.settings.layout == 'grid' }}" },
    { "type": "range", "id": "columns_mobile", "label": "Colonnes (mobile)", "min": 1, "max": 2, "step": 1, "default": 1, "visible_if": "{{ section.settings.layout == 'grid' }}" },
    {
      "type": "select",
      "id": "section_width",
      "label": "Largeur",
      "options": [
        { "value": "page-width", "label": "Page" },
        { "value": "full-width", "label": "Pleine largeur" }
      ],
      "default": "page-width"
    },
    { "type": "header", "content": "Couleurs" },
    { "type": "color", "id": "background_color", "label": "Fond", "placeholder": "Par défaut" },
    { "type": "color", "id": "text_color", "label": "Texte", "placeholder": "Par défaut" },
    { "type": "header", "content": "Espacement" },
    { "type": "range", "id": "padding-block-start", "label": "Haut", "min": 0, "max": 150, "step": 1, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding-block-end", "label": "Bas", "min": 0, "max": 150, "step": 1, "unit": "px", "default": 64 }
  ],
  "presets": [
    {
      "name": "Testimonials / Avis / UGC",
      "category": "t:categories.basic",
      "blocks": [
        { "type": "_testimonial-card" },
        { "type": "_testimonial-card" },
        { "type": "_testimonial-card" }
      ]
    }
  ]
}
{% endschema %}
