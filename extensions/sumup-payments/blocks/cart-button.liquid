{%- comment -%}
  SumUp — cart payment button (Horizon / any Online Store 2.0 theme).

  Reads the live cart from /cart.js at submit time and POSTs the line items,
  discount codes and cart attributes to the `/apps/sumup-pay/cart` app proxy.
  The proxy re-prices everything against Shopify (Storefront Cart API), so the
  browser can never dictate the amount charged. The cart is always re-fetched
  fresh right before submit, never trusted from the DOM.
{%- endcomment -%}

{%- liquid
  assign align = block.settings.alignment | default: 'center'
  assign size = block.settings.button_size | default: 'medium'
-%}

<div
  class="
    sumup-pay-block sumup-pay-block--cart
    {% if block.settings.full_width %}sumup-pay-block--full{% endif %}
    sumup-pay-block--align-{{ align }}
    sumup-pay-block--size-{{ size }}
  "
  {{ block.shopify_attributes }}
  style="
    --sumup-accent: {{ block.settings.accent_color }};
    --sumup-on-accent: {{ block.settings.button_text_color }};
    --sumup-radius: {{ block.settings.corner_radius }}px;
    {% if block.settings.text_color != blank %}--sumup-text: {{ block.settings.text_color }};{% endif %}
  "
  data-sumup-block="cart"
>
  {%- if block.settings.heading != blank -%}
    <p class="sumup-pay-block__heading">{{ block.settings.heading }}</p>
  {%- endif -%}

  <form
    class="sumup-pay-block__form"
    method="post"
    action="/apps/sumup-pay/cart"
    data-sumup-form="cart"
    novalidate
  >
    <input type="hidden" name="cart" value="" data-sumup-cart>
    <input type="hidden" name="discountCodes" value="" data-sumup-discount-codes>
    <input type="hidden" name="cartAttributes" value="" data-sumup-cart-attributes>
    <input type="hidden" name="cartTotal" value="" data-sumup-cart-total>
    <input type="hidden" name="cartToken" value="" data-sumup-cart-token>

    {%- if block.settings.show_email -%}
      <label class="sumup-pay-block__label" for="sumup-cart-email-{{ block.id }}">
        {{ block.settings.email_label | default: 'E-mail pour la confirmation' }}
      </label>
      <input
        class="sumup-pay-block__input"
        id="sumup-cart-email-{{ block.id }}"
        type="email"
        name="email"
        required
        autocomplete="email"
        inputmode="email"
        placeholder="vous@exemple.com"
        {% if customer %}value="{{ customer.email }}"{% endif %}
        data-sumup-email
      >
    {%- else -%}
      <input
        type="hidden"
        name="email"
        {% if customer %}value="{{ customer.email }}"{% endif %}
        data-sumup-email
      >
    {%- endif -%}

    <p class="sumup-pay-block__error" data-sumup-error hidden></p>
    <p class="sumup-pay-block__note" data-sumup-cart-empty hidden>
      {{ block.settings.empty_text | default: 'Votre panier est vide.' }}
    </p>

    <button
      class="sumup-pay-block__button"
      type="submit"
      data-sumup-submit
      data-loading-label="{{ block.settings.loading_label | default: 'Redirection…' | escape }}"
    >
      <span data-sumup-label>{{ block.settings.button_label | default: 'Payer le panier avec SumUp' }}</span>
      <span class="sumup-pay-block__spinner" data-sumup-spinner hidden aria-hidden="true"></span>
    </button>

    {%- if block.settings.subtext != blank -%}
      <p class="sumup-pay-block__subtext">{{ block.settings.subtext }}</p>
    {%- endif -%}

    {%- if block.settings.show_trust -%}
      <p class="sumup-pay-block__trust">🔒 {{ block.settings.trust_text | default: 'Paiement sécurisé par SumUp' }}</p>
    {%- endif -%}
  </form>
</div>

{% schema %}
{
  "name": "SumUp — Panier",
  "target": "section",
  "enabled_on": { "templates": ["cart"] },
  "stylesheet": "sumup-pay.css",
  "javascript": "sumup-pay.js",
  "settings": [
    { "type": "text", "id": "heading", "label": "Titre", "default": "Paiement express" },
    { "type": "text", "id": "button_label", "label": "Texte du bouton", "default": "Payer le panier avec SumUp" },
    { "type": "text", "id": "loading_label", "label": "Texte pendant le chargement", "default": "Redirection…" },
    { "type": "text", "id": "subtext", "label": "Texte secondaire (optionnel)" },
    { "type": "header", "content": "E-mail" },
    { "type": "checkbox", "id": "show_email", "label": "Demander l'e-mail dans le bloc", "default": true, "info": "Décochez si l'e-mail est déjà connu (client connecté)." },
    { "type": "text", "id": "email_label", "label": "Libellé e-mail", "default": "E-mail pour la confirmation" },
    { "type": "header", "content": "Panier vide / réassurance" },
    { "type": "text", "id": "empty_text", "label": "Texte si panier vide", "default": "Votre panier est vide." },
    { "type": "checkbox", "id": "show_trust", "label": "Afficher la mention de sécurité", "default": true },
    { "type": "text", "id": "trust_text", "label": "Mention de sécurité", "default": "Paiement sécurisé par SumUp" },
    { "type": "header", "content": "Apparence" },
    { "type": "checkbox", "id": "full_width", "label": "Bouton pleine largeur", "default": true },
    {
      "type": "select", "id": "alignment", "label": "Alignement", "default": "center",
      "options": [
        { "value": "start", "label": "Gauche" },
        { "value": "center", "label": "Centre" },
        { "value": "end", "label": "Droite" }
      ]
    },
    {
      "type": "select", "id": "button_size", "label": "Taille du bouton", "default": "medium",
      "options": [
        { "value": "small", "label": "Petite" },
        { "value": "medium", "label": "Moyenne" },
        { "value": "large", "label": "Grande" }
      ]
    },
    { "type": "color", "id": "accent_color", "label": "Couleur du bouton", "default": "#1a1a1a" },
    { "type": "color", "id": "button_text_color", "label": "Couleur du texte du bouton", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Couleur du texte du bloc", "placeholder": "Hérité du thème" },
    { "type": "range", "id": "corner_radius", "label": "Arrondi des coins", "min": 0, "max": 30, "step": 1, "unit": "px", "default": 10 }
  ]
}
{% endschema %}
