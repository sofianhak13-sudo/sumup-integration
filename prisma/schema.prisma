// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
   provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
model SumUpPayment {
  checkoutId        String   @id
  checkoutReference String   @unique
  shop              String
  productId         String
  variantId         String
  quantity          Int      @default(1)
  amount            Float
  currency          String
  status            String   @default("PENDING")
  orderId           String?
  statusPageUrl String?
  processing Boolean @default(false)
  customerEmail     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MerchantSettings {
  shop                String   @id
  cartPaymentsEnabled Boolean  @default(true)
  cartDrawerEnabled   Boolean  @default(false)
  hideShopifyCheckout Boolean  @default(false)

  // --- Checkout V2 (additive; every column has a safe default so existing
  //     rows keep the current "fast" behaviour with no back-fill) ---
  advancedCheckoutEnabled Boolean @default(false)
  shippingEnabled         Boolean @default(false)
  // "digital" | "ecommerce" | "custom"
  checkoutPreset          String  @default("digital")
  // Per-field requirement overrides ("disabled" | "optional" | "required")
  // and section toggles. Merged over the preset; see app/lib/checkout-config.js.
  checkoutFieldConfig     Json?
  // Checkout page appearance (logo, title, subtitle, width, radius, trust,
  // CTA label, legal links). See app/lib/checkout-config.js DEFAULT_APPEARANCE.
  checkoutAppearance      Json?
  // Global button presentation overrides (the theme editor still owns the
  // per-placement look; this is the app-wide baseline).
  buttonAppearance        Json?

  // --- SumUp merchant identity (populated by "Vérifier le compte SumUp";
  //     never stores the secret itself) ---
  sumupMerchantName     String?
  sumupMerchantEmail    String?
  sumupApiKeyLast4      String?
  // "unknown" | "ok" | "error"
  sumupAccountStatus    String    @default("unknown")
  sumupAccountCheckedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SumUpCartPayment {
  checkoutId        String   @id
  checkoutReference String   @unique
  shop              String
  customerEmail     String
  items             Json
  amount            Float
  currency          String
  subtotalAmount    Float?
  discountAmount    Float    @default(0)
  discountCodes     String[] @default([])
  cartToken         String?
  snapshot          Json?
  status            String   @default("PENDING")
  orderId           String?
  statusPageUrl     String?
  processing        Boolean  @default(false)

  // --- Checkout V2 buyer / delivery data (additive; all nullable or
  //     defaulted so "fast" rows are unaffected) ---
  // "fast" | "advanced"
  checkoutMode     String  @default("fast")
  firstName        String?
  lastName         String?
  phone            String?
  company          String?
  // { firstName,lastName,company,address1,address2,zip,city,province,
  //   provinceCode,country,countryCode,phone }
  shippingAddress  Json?
  billingAddress   Json?
  // { handle, title, amount, currencyCode } chosen at the checkout step
  shippingMethod   Json?
  shippingAmount   Float   @default(0)
  taxAmount        Float   @default(0)
  // Full advanced-checkout audit snapshot (distinct from `snapshot`, which
  // stays the Storefront pricing snapshot).
  checkoutSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}